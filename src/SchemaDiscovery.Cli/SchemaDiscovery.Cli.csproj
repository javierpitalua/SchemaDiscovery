<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>schema-discovery</AssemblyName>
    <RootNamespace>SchemaDiscovery.Cli</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- dotnet tool packaging: enables `dotnet pack` to produce an installable
       .NET tool, and `dotnet tool install` (globally or with a local
       add-source pointing at ./nupkg) to install it. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>schema-discovery</ToolCommandName>
    <PackageId>SchemaDiscovery.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>javierpitalua</Authors>
    <Description>CLI tool that scans a database's schema (SQL Server, with PostgreSQL/MySQL extension points) and exports each table, view, stored procedure, and function as its own JSON file.</Description>
    <PackageTags>database;schema;sql-server;postgres;mysql;json;dotnet-tool;cli</PackageTags>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>A cli that scans a database and produces json files with schema metadata so AI tools can look and infer your project schema changes. </Title>
    <PackageProjectUrl>https://github.com/javierpitalua/SchemaDiscovery</PackageProjectUrl>
    <PackageIcon>logo01.png</PackageIcon>
    <RepositoryUrl>https://github.com/javierpitalua/SchemaDiscovery</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed into the .nupkg so it shows up on nuget.org / internal feeds. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="..\CommonAssets\img\logo01.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchemaDiscovery.Providers.SqlServer\SchemaDiscovery.Providers.SqlServer.csproj" />
    <ProjectReference Include="..\SchemaDiscovery.Providers.PostgreSql\SchemaDiscovery.Providers.PostgreSql.csproj" />
    <ProjectReference Include="..\SchemaDiscovery.Providers.MySql\SchemaDiscovery.Providers.MySql.csproj" />
    <ProjectReference Include="..\SchemaDiscovery\SchemaDiscovery.csproj" />
  </ItemGroup>

</Project>
