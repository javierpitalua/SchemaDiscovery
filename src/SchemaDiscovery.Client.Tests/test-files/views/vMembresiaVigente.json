  "Definition": "CREATE VIEW [dbo].[vMembresiaVigente]\r\nAS\r\n\r\n\tSELECT \r\n\t\t[Membresia].[Id],\t\t\r\n\t\t[Membresia].[ClaveMembresia],\r\n\t\t[InformacionFacturacion].[NombreFiscal],\r\n\t\t[InformacionFacturacion].[RazonSocial],\r\n\t\t[InformacionFacturacion].[RFC],\r\n\t\t[TipoMembresia].[Nombre] AS [TipoMembresia],\r\n\t\t[EstatusMembresia].[Nombre] AS [Estatus],\t\t\r\n\t\t[Membresia].[FacturarAPartirDe],\r\n\t\t[Membresia].[FechaInicio] AS [FechaInicio],\r\n\t\t[Membresia].[Vigencia],\t\t\t\t\t\t\r\n\t\tCASE [Membresia].[DeshabilitarFacturacionAutomatica] WHEN 1 THEN \u0027S\u00ED\u0027 ELSE \u0027No\u0027 END AS [DeshabilitarFacturacionAutomatica],\r\n\t\t[Membresia].[FechaCreacion] as [FechaCreacion],\r\n\t\t[Membresia].[CreadoPor] as [CreadoPor],\r\n\t\tCASE ISNULL([Membresia].[DeshabilitarFacturacionAutomatica], 0) WHEN 0 THEN \u0027No\u0027 ELSE \u0027S\u00ED\u0027 END AS [DeshabilitarFacturacion],\t\t\r\n\t\t[Membresia].[PrecioMensual],\t\t\r\n\t\t[TipoDeCambio].[Nombre] AS [TipoDeCambio]\r\n\tFROM [dbo].[Membresia] \r\n\r\n\t\tLEFT JOIN [dbo].[Comunidad]\r\n\t\tON [dbo].[Membresia].[Comunidad_Id] = [dbo].[Comunidad].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[TipoMembresia]\r\n\t\tON [dbo].[Membresia].[TipoMembresia_Id] = [dbo].[TipoMembresia].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[EstatusMembresia]\r\n\t\tON [dbo].[Membresia].[EstatusMembresia_Id] = [dbo].[EstatusMembresia].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[InformacionFacturacion]\r\n\t\tON [dbo].[Membresia].[InformacionFacturacion_Id] = [dbo].[InformacionFacturacion].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[TipoDeCambio]\r\n\t\tON [dbo].[Membresia].[TipoDeCambio_Id] = [dbo].[TipoDeCambio].[Id] \r\n\t\t\r\n\t\tWHERE [Membresia].[Activo] = 1",
