  "Definition": "CREATE PROCEDURE [dbo].[rpt_PaqueteriaActivas_ObtenerListadoPorPaqueteria]\n@SuscriptorId INT\nAS\nBEGIN\n\nDECLARE @Paqueteria TABLE (\n\tId INT IDENTITY(1,1),\n\tPaqueteria_Id INT \n)\n\nINSERT INTO @Paqueteria (Paqueteria_Id)\nSELECT paq.Id FROM Paqueteria paq\nJOIN Membresia mem ON paq.Membresia_Id = mem.Id\nJOIN Suscripcion sus ON sus.Membresia_Id = mem.Id\nWHERE sus.Suscriptor_Id = @SuscriptorId\nAND paq.Activo = 1\nAND mem.Activo = 1\nAND sus.Activo = 1\nAND sus.TipoSuscripcion_Id = 2 -- Administrador\nAND mem.EstatusMembresia_Id = 1 -- Membresias Activas\n\n-- =====================================================================\n\nINSERT INTO @Paqueteria (Paqueteria_Id)\nSELECT paq.Id FROM Paqueteria paq\nJOIN Membresia mem ON paq.Membresia_Id = mem.Id\nJOIN Suscripcion sus ON sus.Membresia_Id = mem.Id\nWHERE sus.Suscriptor_Id = @SuscriptorId\nAND paq.Activo = 1\nAND mem.Activo = 1\nAND sus.Activo = 1\nAND sus.TipoSuscripcion_Id = 1 -- Beneficiario\nAND paq.Suscriptor_Id = @SuscriptorId -- Solo del Suscriptor\nAND mem.EstatusMembresia_Id = 1 -- Membresias Activas\n\nSELECT \n\tpaq.Id,\n\tinfo.RazonSocial,\n\tcom.Nombre AS [Comunidad],\n\tpaq.Membresia_Id,\n\tmem.ClaveMembresia,\n\tpaq.Guia,\n\tcr1.Nombre AS [Carrier],\n\ttpaq.Nombre AS [TipoPaquete],\n\tsus.CorreoElectronico AS [CorreoElectronicoSuscriptor], \n\t(sus.Nombre \u002B \u0027 \u0027 \u002B sus.ApellidoPaterno \u002B \u0027 \u0027 \u002B sus.ApellidoMaterno) AS [NombreSuscriptor], -- Nombre Suscriptor\n\test.Nombre AS [EstatusPaqueteria],\n\tpaq.EstatusPaqueteria_Id,\n\tpaq.FechaCreacion,\n\tpaq.Fecha,\n\trep.CorreoElectronico AS [CorreoElectronicoReceptor],\n\t(rep.Nombre \u002B \u0027 \u0027 \u002B rep.ApellidoPaterno \u002B \u0027 \u0027 \u002B rep.ApellidoMaterno) AS [NombreReceptor],\n\tent.FechaEntrega\nFROM Paqueteria paq \nJOIN (\n\tSELECT Paqueteria_Id FROM @Paqueteria tmp2\n\tGROUP BY Paqueteria_Id \n) AS tmp1 ON tmp1.Paqueteria_Id = paq.Id\nJOIN Membresia mem ON paq.Membresia_Id = mem.Id\nJOIN InformacionFacturacion info ON mem.InformacionFacturacion_Id = info.Id\nJOIN Carrier cr1 ON paq.Carrier_Id = cr1.Id\nJOIN Suscriptor sus ON paq.Suscriptor_Id = sus.Id\nJOIN EstatusPaqueteria est ON paq.EstatusPaqueteria_Id = est.Id\nJOIN Comunidad com ON mem.Comunidad_Id = com.Id\nJOIN TipoPaquete tpaq ON paq.TipoPaquete_Id = tpaq.Id\nLEFT JOIN EntregaPaqueteria ent ON paq.Id = ent.Paqueteria_Id\nLEFT JOIN Usuario rep ON ent.Usuario_Id = rep.Id\n\nEND",
  "Schema": "dbo",
