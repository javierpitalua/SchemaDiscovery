  "Definition": "CREATE PROCEDURE [dbo].[rpt_ComunidadesActivas_ObtenerComunidadesPorUsuarioActivo]\n@SuscriptorId INT\nAS\nBEGIN\n\nSELECT \n\tc1.Id,\n\tc1.Nombre,\n\tc1.Telefono\nFROM Comunidad c1 JOIN (\nSELECT mem.Comunidad_Id FROM Suscripcion sus\nJOIN Membresia mem ON sus.Membresia_Id = mem.Id\nWHERE Suscriptor_Id = @SuscriptorId\nAND sus.Activo = 1\nGROUP BY mem.Comunidad_Id\n) AS c2 ON c2.Comunidad_Id = c1.Id\n\nEND",
