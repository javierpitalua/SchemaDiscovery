  "Definition": "\r\n-- =================================================================\r\n-- Description:\tThis gets a basic report for [ActivoInventario] table\r\n-- =================================================================\r\nCREATE PROCEDURE [dbo].[rpt_ActivoInventario_Index]\r\n@EntityId AS INT = 0, \r\n@Comunidad_Id AS INT = 0, \r\n@Ubicacion_Id AS INT = 0, \r\n@TipoInventario_Id AS INT = 0\r\nAS\r\nBEGIN\r\n\t\r\n\t-- IMPORTANT:\r\n\t-- This is a computer generated procedure.  DO NOT ADD CUSTOM CODE TO THIS PROCEDURE.\r\n\r\n\t-- SET NOCOUNT ON added to prevent extra result sets from\r\n\t-- interfering with SELECT statements.\r\n\tSET NOCOUNT ON;\r\n\t\r\n\t-- 1) CREATE FILTER TABLE:\r\n\tDECLARE @ActivoInventarioFilter TABLE (\r\n\t\tId INT IDENTITY (1,1),\r\n\t\tActivoInventario_Id INT\t\t\r\n\t)\r\n\r\n\r\n    -- IF A GIVEN ID HAS BEEN SPECIFIED, THEN RETRIEVE THAT RECORD ONLY\r\n\tIF @EntityId \u003C\u003E 0\r\n\tBEGIN\r\n\r\n\t\tINSERT INTO @ActivoInventarioFilter (ActivoInventario_Id)\r\n\t\tSELECT \r\n\t\t\t[ActivoInventario].Id\r\n\t\tFROM [dbo].[ActivoInventario]\r\n\t\tWHERE\r\n\t\t\t [dbo].[ActivoInventario].[Id] = @EntityId\r\n\r\n\tEND\r\n\tELSE\r\n\tBEGIN\r\n\r\n\t\t-- 2) FILTER BY FOREIGN RELATIONSHIPS WHEN APLICABLE:\r\n\t\tINSERT INTO @ActivoInventarioFilter (ActivoInventario_Id)\r\n\t\tSELECT \r\n\t\t\t[ActivoInventario].Id\r\n\t\tFROM [dbo].[ActivoInventario]\r\n\t\tWHERE\r\n\t\t\t [ActivoInventario].[Activo] = 1 AND\r\n         (([ActivoInventario].[Comunidad_Id] = @Comunidad_Id) OR (@Comunidad_Id = 0)) AND\r\n         (([ActivoInventario].[Ubicacion_Id] = @Ubicacion_Id) OR (@Ubicacion_Id = 0)) AND\r\n         (([ActivoInventario].[TipoInventario_Id] = @TipoInventario_Id) OR (@TipoInventario_Id = 0))\r\n\r\n \tEND\r\n\r\n \r\n\t-- 4) DELIVER THE FILTERED RESULTS:\r\n\tSELECT \r\n\t\t[ActivoInventario].[Id],\r\n\t\t[ActivoInventario].[Descripcion],\r\n\t\t[ActivoInventario].[NumeroDeSerie],\r\n\t\t[ActivoInventario].[FechaAdquisicion],\r\n\t\t[ActivoInventario].[Comunidad_Id],\r\n\t\t[ActivoInventario].[Ubicacion_Id],\r\n\t\t[ActivoInventario].[TipoInventario_Id],\r\n\t\t[ActivoInventario].[Activo],\r\n\t\t[ActivoInventario].[FechaDesactivacion],\r\n\t\t[ActivoInventario].[DesactivadoPor],\r\n\t\t[Comunidad].[Nombre] AS [ComunidadNombre],\r\n\t\t[Ubicacion].[Nombre] AS [UbicacionNombre],\r\n\t\t[TipoInventario].[Nombre] AS [TipoInventarioNombre],\r\n\t\t[ActivoInventario].[FechaCreacion],\r\n\t\t[ActivoInventario].[CreadoPor],\r\n\t\t[ActivoInventario].[FechaModificacion],\r\n\t\t[ActivoInventario].[ModificadoPor]\r\n\tFROM @ActivoInventarioFilter filter\r\n\t\tJOIN [dbo].[ActivoInventario] \r\n\t\t\tON [ActivoInventario].[Id] = filter.[ActivoInventario_Id] \r\n\t\t\t\r\n\r\n\t\tLEFT JOIN [dbo].[Comunidad]\r\n\t\tON [dbo].[ActivoInventario].[Comunidad_Id] = [dbo].[Comunidad].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[Ubicacion]\r\n\t\tON [dbo].[ActivoInventario].[Ubicacion_Id] = [dbo].[Ubicacion].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[TipoInventario]\r\n\t\tON [dbo].[ActivoInventario].[TipoInventario_Id] = [dbo].[TipoInventario].[Id] \r\n\r\n \r\nEND\r\n-- END OF [dbo].[cgp_ActivoInventario_Index]",
