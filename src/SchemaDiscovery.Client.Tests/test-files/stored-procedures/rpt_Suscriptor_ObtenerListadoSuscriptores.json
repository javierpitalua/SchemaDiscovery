  "Definition": "CREATE PROCEDURE [dbo].[rpt_Suscriptor_ObtenerListadoSuscriptores]\r\nAS\r\nBEGIN\r\n\r\n\tDECLARE @Suscriptores TABLE (\r\n\t\tId INT IDENTITY(1,1),\r\n\t\tSuscriptor_Id INT\r\n\t)\r\n\t\r\n\tINSERT INTO @Suscriptores (Suscriptor_Id)\r\n\tSELECT DISTINCT(susc.Suscriptor_Id)\r\n\tFROM Suscripcion susc \r\n\t\tJOIN Membresia memb ON susc.Membresia_Id = memb.Id\r\n\t\tJOIN Suscriptor sus ON susc.Suscriptor_Id = sus.Id\r\n\tWHERE \r\n\t\tmemb.Activo = 1\r\n\tAND memb.EstatusMembresia_Id = 1\r\n\tAND sus.Activo = 1\t\r\n\r\n\tSELECT \r\n\t\tsus.Id,\r\n\t\tsus.Nombre,\r\n\t\tsus.ApellidoMaterno,\r\n\t\tsus.ApellidoPaterno,\r\n\t\tsus.CorreoElectronico,\t\t\t\t\r\n\t\tsus.[UltimaAutenticacion],\r\n\t\tCASE ISNULL(sus.CuentaConfirmada, 0) WHEN 1 THEN \u0027S\u00ED\u0027 ELSE \u0027No\u0027 END AS [CuentaConfirmada],\r\n\t\tsus.[FechaConfirmacion],\r\n\t\tCASE ISNULL(sus.[Habilitado], 0) WHEN 1 THEN \u0027S\u00ED\u0027 ELSE \u0027No\u0027 END AS [Habilitado],\r\n\t\tsus.[FechaCreacion],\r\n\t\tsus.[CreadoPor],\r\n\t\tsus.[FechaModificacion],\r\n\t\tsus.[ModificadoPor]\r\n\tFROM @Suscriptores tmp\r\n\t\tJOIN Suscriptor sus ON tmp.Suscriptor_Id = sus.Id\r\n\tWHERE LTRIM(RTRIM(sus.CorreoElectronico)) \u003C\u003E \u0027\u0027\r\n\r\nEND",
  "Schema": "dbo",
