  "Definition": "CREATE PROCEDURE [dbo].[rpt_CicloFacturacionItem_ObtenerCiclosVigentes]\r\nAS\r\nBEGIN\r\n\r\n\tSELECT \r\n\t\tcdf.Id, cdf.Mes, cdf.Anio \r\n\tFROM \r\n\t\tCicloDeFacturacion cdf\r\n\tWHERE cdf.Vigente = 1\r\n\tORDER BY cdf.Anio DESC, cdf.Mes DESC\r\n\r\nEND",
