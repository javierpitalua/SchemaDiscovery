  "Definition": "\r\n-- =================================================================\r\n-- Description:\tThis gets a basic report for [Publicacion] table\r\n-- =================================================================\r\nCREATE PROCEDURE [dbo].[rpt_Publicacion_Index]\r\n@EntityId AS INT = 0, \r\n@Comunidad_Id AS INT = 0, \r\n@Suscriptor_Id AS INT = 0\r\nAS\r\nBEGIN\r\n\t\r\n\t-- IMPORTANT:\r\n\t-- This is a computer generated procedure.  DO NOT ADD CUSTOM CODE TO THIS PROCEDURE.\r\n\r\n\t-- SET NOCOUNT ON added to prevent extra result sets from\r\n\t-- interfering with SELECT statements.\r\n\tSET NOCOUNT ON;\r\n\t\r\n\t-- 1) CREATE FILTER TABLE:\r\n\tDECLARE @PublicacionFilter TABLE (\r\n\t\tId INT IDENTITY (1,1),\r\n\t\tPublicacion_Id INT\t\t\r\n\t)\r\n\r\n\r\n    -- IF A GIVEN ID HAS BEEN SPECIFIED, THEN RETRIEVE THAT RECORD ONLY\r\n\tIF @EntityId \u003C\u003E 0\r\n\tBEGIN\r\n\r\n\t\tINSERT INTO @PublicacionFilter (Publicacion_Id)\r\n\t\tSELECT \r\n\t\t\t[Publicacion].Id\r\n\t\tFROM [dbo].[Publicacion]\r\n\t\tWHERE\r\n\t\t\t [dbo].[Publicacion].[Id] = @EntityId\r\n\r\n\tEND\r\n\tELSE\r\n\tBEGIN\r\n\r\n\t\t-- 2) FILTER BY FOREIGN RELATIONSHIPS WHEN APLICABLE:\r\n\t\tINSERT INTO @PublicacionFilter (Publicacion_Id)\r\n\t\tSELECT \r\n\t\t\t[Publicacion].Id\r\n\t\tFROM [dbo].[Publicacion]\r\n\t\tWHERE\r\n\t\t\t [Publicacion].[Activo] = 1 AND\r\n         (([Publicacion].[Comunidad_Id] = @Comunidad_Id) OR (@Comunidad_Id = 0)) AND\r\n         (([Publicacion].[Suscriptor_Id] = @Suscriptor_Id) OR (@Suscriptor_Id = 0))\r\n\r\n \tEND\r\n\r\n \r\n\t-- 4) DELIVER THE FILTERED RESULTS:\r\n\tSELECT \r\n\t\t[Publicacion].[Id],\r\n\t\t[Publicacion].[Comunidad_Id],\r\n\t\t[Publicacion].[Titulo],\r\n\t\t[Publicacion].[Descripcion],\r\n\t\t[Publicacion].[FechaPublicacion],\r\n\t\t[Publicacion].[PublicarDesde],\r\n\t\t[Publicacion].[PublicarHasta],\r\n\t\t[Publicacion].[Activo],\r\n\t\t[Comunidad].[Nombre] AS [ComunidadNombre],\r\n\t\t[Suscriptor].[CorreoElectronico] AS [SuscriptorCorreoElectronico],\r\n\t\t[Suscriptor].[Nombre] \u002B \u0027 \u0027 \u002B [Suscriptor].[ApellidoPaterno] \u002B \u0027 \u0027 \u002B [Suscriptor].[ApellidoMaterno]  AS [SuscriptorNombre],\r\n\t\t[Publicacion].[FechaDesactivacion],\r\n\t\t[Publicacion].[DesactivadoPor],\r\n\t\t[Publicacion].[Suscriptor_Id]\t\t\r\n\tFROM @PublicacionFilter filter\r\n\t\tJOIN [dbo].[Publicacion] \r\n\t\t\tON [Publicacion].[Id] = filter.[Publicacion_Id] \r\n\t\t\t\r\n\r\n\t\tLEFT JOIN [dbo].[Comunidad]\r\n\t\tON [dbo].[Publicacion].[Comunidad_Id] = [dbo].[Comunidad].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[Suscriptor]\r\n\t\tON [dbo].[Publicacion].[Suscriptor_Id] = [dbo].[Suscriptor].[Id] \r\n\r\n \r\nEND\r\n-- END OF [dbo].[cgp_Publicacion_Index]",
