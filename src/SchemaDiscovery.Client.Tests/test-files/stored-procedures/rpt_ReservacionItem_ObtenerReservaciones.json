  "Definition": "CREATE PROCEDURE [dbo].[rpt_ReservacionItem_ObtenerReservaciones]\r\n@Espacio_Id INT = 0,\r\n@FechaHoraInicial SMALLDATETIME,\r\n@FechaHoraFinal SMALLDATETIME\r\nAS\r\nBEGIN\r\n\r\n\tSELECT \r\n\t\tres.Id,\r\n\t\tmem.ClaveMembresia AS [Titulo],\r\n\t\tres.Descripcion,\r\n\t\tesp.Nombre [Espacio],\r\n\t\tesp.Descripcion [EspacioDescripcion],\r\n\t\tubi.Nombre [Ubicacion],\r\n\t\tres.FechaHoraInicial,\r\n\t\tDATEADD(minute, res.Duracion, res.FechaHoraInicial) AS FechaHoraFinal,\r\n\t\tres.Duracion,\r\n\t\tres.FechaReservacion,\r\n\t\tres.FechaCreacion,\r\n\t\tres.CreadoPor,\r\n\t\tres.Membresia_Id,\r\n\t\tmem.ClaveMembresia\r\n\tFROM\r\n\t\tReservacion res\r\n\t\tLEFT JOIN Espacio esp\r\n\t\t\tON res.Espacio_Id = esp.Id\r\n\t\tLEFT JOIN Ubicacion ubi\r\n\t\t\tON esp.Ubicacion_Id = ubi.Id\t\t\r\n\t\tLEFT JOIN Membresia mem\r\n\t\t\tON res.Membresia_Id = mem.Id\r\n\tWHERE \r\n\t\tres.Espacio_Id = @Espacio_Id\r\n\tAND res.FechaHoraInicial \u003E= @FechaHoraInicial\r\n\tAND DATEADD(minute, res.Duracion, res.FechaHoraInicial) \u003C= @FechaHoraFinal\r\n\tAND res.Activo = 1\r\n\tAND ISNULL(res.Cancelado, 0) = 0\r\n\r\nEND",
  "Schema": "dbo",
