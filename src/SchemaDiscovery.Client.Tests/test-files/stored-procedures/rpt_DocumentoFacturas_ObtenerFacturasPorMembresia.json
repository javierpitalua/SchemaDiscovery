  "Definition": "CREATE PROCEDURE [dbo].[rpt_DocumentoFacturas_ObtenerFacturasPorMembresia] \r\n@MembresiaId INT\r\nAS\r\nBEGIN\r\n\r\n\tDECLARE @Documentos TABLE(\r\n\t\tId INT IDENTITY(1,1),\r\n\t\tDocumento_Id INT,\r\n\t\tIncluirEnResultados BIT\r\n\t)\t\r\n\tINSERT INTO @Documentos (Documento_Id, IncluirEnResultados)\r\n\tSELECT Id, 1 FROM Documento doc \r\n\tWHERE \r\n\t\tdoc.Activo = 1 \t\r\n\tAND doc.CategoriaDocumento_Id IN (3, 8) -- Solo facturas y remisiones\r\n\tAND doc.EstatusDocumento_Id IN (1,2,5) -- Solo Estatus Generados, Pendientes o Retrasados\r\n\tAND doc.Membresia_Id = @MembresiaId\t\r\n\r\n\tSELECT \r\n\t\tdoc.Id,\r\n\t\tdoc.Folio,\r\n\t\tdoc.CicloDeFacturacion_Id,\r\n\t\tdoc.Membresia_Id,\r\n\t\tmem.ClaveMembresia,\r\n\t\tdbo.fnObtenerDescripcionMes(ciclo.Mes) \u002B \u0027 \u0027 \u002B CONVERT(VARCHAR(100), ciclo.Anio) AS CicloDeFacturacion,\r\n\t\tdoc.FechaEmision,\r\n\t\tdoc.FechaCreacion,\r\n\t\tdoc.MontoTotal,\r\n\t\tdoc.IVA,\r\n\t\tdoc.MontoTotal \u002B doc.IVA AS MontoTotalMasIVA,\r\n\t\tCASE ISNULL(doc.Pagado, 0) WHEN 0 THEN \u0027No\u0027 WHEN 1 THEN \u0027S\u00ED\u0027 END AS Pagado,\r\n\t\tcat.Nombre AS Categoria,\r\n\t\tdoc.CategoriaDocumento_Id,\r\n\t\tdoc.EstatusDocumento_Id,\r\n\t\test.Nombre AS Estatus,\r\n\t\ttdc.Abreviacion AS [TipoDeCambio]\r\n\tFROM @Documentos tmp\r\n\t\tJOIN Documento doc ON tmp.Documento_Id = doc.Id\r\n\t\tJOIN Membresia mem ON doc.Membresia_Id = mem.Id\r\n\t\tLEFT JOIN CicloDeFacturacion ciclo ON doc.CicloDeFacturacion_Id = ciclo.Id\r\n\t\tLEFT JOIN CategoriaDocumento cat ON doc.CategoriaDocumento_Id = cat.Id\r\n\t\tLEFT JOIN EstatusDocumento est ON doc.EstatusDocumento_Id = est.Id\r\n\t\tLEFT JOIN TipoDeCambio tdc ON doc.TipoDeCambio_Id = tdc.Id\r\n\tWHERE doc.Activo = 1\r\n\tAND tmp.IncluirEnResultados = 1\r\n\tAND doc.Pagado = 0\r\n\t\r\nEND",
  "Schema": "dbo",
  "Name": "rpt_DocumentoFacturas_ObtenerFacturasPorMembresia",
