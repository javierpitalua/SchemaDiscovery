  "Definition": "\r\n-- =================================================================\r\n-- Description:\tThis gets a basic report for [Reservacion] table\r\n-- =================================================================\r\nCREATE PROCEDURE [dbo].[rpt_Reservacion_Index]\r\n@EntityId AS INT = 0, \r\n@Espacio_Id AS INT = 0, \r\n@Membresia_Id AS INT = 0, \r\n@Suscriptor_Id AS INT = 0\r\nAS\r\nBEGIN\r\n\t\r\n\t-- IMPORTANT:\r\n\t-- This is a computer generated procedure.  DO NOT ADD CUSTOM CODE TO THIS PROCEDURE.\r\n\r\n\t-- SET NOCOUNT ON added to prevent extra result sets from\r\n\t-- interfering with SELECT statements.\r\n\tSET NOCOUNT ON;\r\n\t\r\n\t-- 1) CREATE FILTER TABLE:\r\n\tDECLARE @ReservacionFilter TABLE (\r\n\t\tId INT IDENTITY (1,1),\r\n\t\tReservacion_Id INT\t\t\r\n\t)\r\n\r\n\r\n    -- IF A GIVEN ID HAS BEEN SPECIFIED, THEN RETRIEVE THAT RECORD ONLY\r\n\tIF @EntityId \u003C\u003E 0\r\n\tBEGIN\r\n\r\n\t\tINSERT INTO @ReservacionFilter (Reservacion_Id)\r\n\t\tSELECT \r\n\t\t\t[Reservacion].Id\r\n\t\tFROM [dbo].[Reservacion]\r\n\t\tWHERE\r\n\t\t\t [dbo].[Reservacion].[Id] = @EntityId\r\n\r\n\tEND\r\n\tELSE\r\n\tBEGIN\r\n\r\n\t\t-- 2) FILTER BY FOREIGN RELATIONSHIPS WHEN APLICABLE:\r\n\t\tINSERT INTO @ReservacionFilter (Reservacion_Id)\r\n\t\tSELECT \r\n\t\t\t[Reservacion].Id\r\n\t\tFROM [dbo].[Reservacion]\r\n\t\tWHERE\r\n\t\t\t (([Reservacion].[Espacio_Id] = @Espacio_Id) OR (@Espacio_Id = 0)) AND\r\n         (([Reservacion].[Membresia_Id] = @Membresia_Id) OR (@Membresia_Id = 0)) AND\r\n         (([Reservacion].[Suscriptor_Id] = @Suscriptor_Id) OR (@Suscriptor_Id = 0))\r\n\r\n \tEND\r\n\r\n \r\n\t-- 4) DELIVER THE FILTERED RESULTS:\r\n\tSELECT \r\n\t\t[Reservacion].[Id],\r\n\t\t[Reservacion].[Titulo],\r\n\t\t[Reservacion].[Descripcion],\r\n\t\t[Reservacion].[Espacio_Id],\r\n\t\t[Reservacion].[Membresia_Id],\r\n\t\t[Reservacion].[FechaHoraInicial],\t\t\r\n\t\t[Reservacion].[Duracion],\r\n\t\t[Reservacion].[Suscriptor_Id],\r\n\t\t[Reservacion].[FechaReservacion],\r\n\t\t[Reservacion].[Cancelado],\r\n\t\t[Reservacion].[FechaCancelacion],\r\n\t\t[Reservacion].[CanceladoPor],\r\n\t\t[Espacio].[Nombre] AS [EspacioNombre],\r\n\t\t[Espacio].[Descripcion] AS [EspacioDescripcion],\r\n\t\t[Membresia].[ClaveMembresia] AS [MembresiaClaveMembresia],\r\n\t\t[Suscriptor].[CorreoElectronico] AS [SuscriptorCorreoElectronico],\r\n\t\t[Suscriptor].[Nombre] AS [SuscriptorNombre]\r\n\tFROM @ReservacionFilter filter\r\n\t\tJOIN [dbo].[Reservacion] \r\n\t\t\tON [Reservacion].[Id] = filter.[Reservacion_Id] \r\n\t\t\t\r\n\r\n\t\tLEFT JOIN [dbo].[Espacio]\r\n\t\tON [dbo].[Reservacion].[Espacio_Id] = [dbo].[Espacio].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[Membresia]\r\n\t\tON [dbo].[Reservacion].[Membresia_Id] = [dbo].[Membresia].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[Suscriptor]\r\n\t\tON [dbo].[Reservacion].[Suscriptor_Id] = [dbo].[Suscriptor].[Id] \r\n\r\n \r\nEND\r\n-- END OF [dbo].[cgp_Reservacion_Index]",
