  "Definition": "-- =================================================================\r\n-- Description:\tThis gets a basic report for [Reporte ConceptoAdicional] table\r\n-- =================================================================\r\nCREATE PROCEDURE [dbo].[rpt_ConceptoAdicional_ObtenerCargosAdicionales]\r\n@Comunidad_Id AS INT = 0,    \r\n@CicloFacturacion_Id AS INT = 0\r\nAS\r\nBEGIN\r\n\t\r\n\t-- IMPORTANT:\r\n\t-- This is a computer generated procedure.  DO NOT ADD CUSTOM CODE TO THIS PROCEDURE.\r\n\r\n\t-- SET NOCOUNT ON added to prevent extra result sets from\r\n\t-- interfering with SELECT statements.\r\n\tSET NOCOUNT ON;\r\n\t\r\n\t-- 1) CREATE FILTER TABLE:\r\n\tDECLARE @ConceptoAdicionalFilter TABLE (\r\n\t\tId INT IDENTITY (1,1),\r\n\t\tConceptoAdicional_Id INT,\r\n\t\tMesFacturacion Varchar(50)\r\n\t)\r\n\t\r\n    -- FILTER BY FOREIGN RELATIONSHIPS WHEN APLICABLE:\r\n\t\r\n\tBEGIN\r\n\r\n\t\tINSERT INTO @ConceptoAdicionalFilter (ConceptoAdicional_Id, MesFacturacion)\r\n\t\tSELECT \r\n\t\t\t[ConceptoAdicional].Id,\r\n\t\t\tdbo.fnObtenerDescripcionMes(MONTH([ConceptoAdicional].[FechaCreacion])) \u002B \u0027 \u0027 \u002B CONVERT(VARCHAR(10), YEAR([ConceptoAdicional].[FechaCreacion])) AS [MesFacturacion]\t\t \r\n\t\tFROM [dbo].[ConceptoAdicional]\r\n\t\tLEFT JOIN [Membresia] ON [ConceptoAdicional].[Membresia_Id] = [Membresia].[Id]\r\n\r\n\t\tWHERE\r\n\t\t\t [ConceptoAdicional].[Activo] = 1 AND\r\n        (([Membresia].[Comunidad_Id] = @Comunidad_Id) OR (@Comunidad_Id = 0)) AND\r\n\t\t[ConceptoAdicional].[FechaCreacion] between DATEADD(month, -2, GETDATE())  and getdate()\r\n\r\n \tEND\r\n\t\r\n\tDECLARE @DescripcionCicloFacturacion VARCHAR(50) \r\n\r\n\tSELECT @DescripcionCicloFacturacion = [dbo].[fnObtenerDescripcionMes](cf.Mes) \u002B \u0027 \u0027 \u002B CONVERT(VARCHAR(10), cf.Anio)\r\n\tFROM CicloDeFacturacion cf\r\n\tWHERE cf.Id = @CicloFacturacion_Id\r\n\r\n\t-- 4) DELIVER THE FILTERED RESULTS:\r\n\tSELECT \r\n\t\t[ConceptoAdicional].[Id],\r\n\t\t[Membresia].[ClaveMembresia] AS [MembresiaClaveMembresia],\r\n\t\t[Comunidad].[Nombre] AS [Comunidad],\r\n\t\t[InformacionFacturacion].[RazonSocial],\r\n\t\t[InformacionFacturacion].[NombreFiscal],\r\n\t\t[ConceptoFacturable].[Concepto] AS [ConceptoFacturableConcepto],\r\n\t\t[ConceptoFacturable].[Descripcion] AS [ConceptoFacturableDescripcion],\r\n\t\t[ConceptoAdicional].[Cantidad],\r\n\t\t[ConceptoFacturable].[PrecioUnitario] AS [PrecioUnitario],\r\n\t\tISNULL([ConceptoFacturable].[PrecioUnitario], 0) * ISNULL([ConceptoAdicional].[Cantidad], 0) AS [Total],\r\n\t\t[Suscriptor].[Nombre] \u002B \u0027 \u0027 \u002B [Suscriptor].[ApellidoPaterno] \u002B \u0027 \u0027 \u002B [Suscriptor].[ApellidoMaterno] \u002B \u0027 (\u0027 \u002B [Suscriptor].[CorreoElectronico] \u002B \u0027)\u0027 AS [SuscriptorNombre],\t\t\r\n\t\t[ConceptoAdicional].[Membresia_Id],\r\n\t\t[ConceptoAdicional].[ConceptoFacturable_Id],\t\t\r\n\t\t[ConceptoAdicional].[Facturado],\r\n\t\t[ConceptoAdicional].[Documento_Id],\r\n\t\t[ConceptoAdicional].[Suscriptor_Id],\r\n\t\t[ConceptoAdicional].[Activo],\r\n\t\t[ConceptoAdicional].[FechaDesactivacion],\r\n\t\t[ConceptoAdicional].[DesactivadoPor],\t\t\r\n\t\t[Documento].[Folio] AS [DocumentoFolio],\r\n\t\t[ConceptoAdicional].[FechaCreacion],\r\n\t\t[filter].[MesFacturacion] AS [MesFacturacion],\r\n\t\t[ConceptoAdicional].[CreadoPor],\r\n\t\t[ConceptoAdicional].[FechaModificacion],\r\n\t\t[ConceptoAdicional].[ModificadoPor]\t\t\t\t\r\n\tFROM @ConceptoAdicionalFilter filter\r\n\t\tJOIN [dbo].[ConceptoAdicional] \r\n\t\t\tON [ConceptoAdicional].[Id] = filter.[ConceptoAdicional_Id] \r\n\t\t\t\r\n\r\n\t\tLEFT JOIN [dbo].[Membresia]\r\n\t\tON [dbo].[ConceptoAdicional].[Membresia_Id] = [dbo].[Membresia].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[Comunidad]\r\n\t\tON [dbo].[Membresia].[Comunidad_Id] = [dbo].[Comunidad].[Id]\r\n\r\n \t\tLEFT JOIN [dbo].[ConceptoFacturable]\r\n\t\tON [dbo].[ConceptoAdicional].[ConceptoFacturable_Id] = [dbo].[ConceptoFacturable].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[Documento]\r\n\t\tON [dbo].[ConceptoAdicional].[Documento_Id] = [dbo].[Documento].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[Suscriptor]\r\n\t\tON [dbo].[ConceptoAdicional].[Suscriptor_Id] = [dbo].[Suscriptor].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[InformacionFacturacion]\r\n\t\tON [dbo].[Membresia].[InformacionFacturacion_Id] = [dbo].[InformacionFacturacion].[Id] \r\n\r\n\t\tWHERE [ConceptoAdicional].[Facturado]= 0 \r\n\t\tAND ((filter.MesFacturacion = @DescripcionCicloFacturacion) OR(@DescripcionCicloFacturacion is null))\r\n\r\n\t\tORDER BY [ConceptoAdicional].[FechaCreacion] DESC\r\nEND\r\n-- END OF [dbo].[rpt_ConceptoAdicional_ObtenerCargosAdicionales]",
