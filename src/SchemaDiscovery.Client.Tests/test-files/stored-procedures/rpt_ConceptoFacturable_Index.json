rable].[FechaDesactivacion],\r\n\t\t[ConceptoFacturable].[DesactivadoPor],\t\t\r\n\t\t[ConceptoFacturable].[FechaCreacion],\r\n\t\t[ConceptoFacturable].[CreadoPor],\r\n\t\t[ConceptoFacturable].[FechaModificacion],\r\n\t\t[ConceptoFacturable].[ModificadoPor]\r\n\tFROM @ConceptoFacturableFilter filter\r\n\t\tJOIN [dbo].[ConceptoFacturable] \r\n\t\t\tON [ConceptoFacturable].[Id] = filter.[ConceptoFacturable_Id] \r\n\t\t\t\r\n\r\n\t\tLEFT JOIN [dbo].[CategoriaConcepto]\r\n\t\tON [dbo].[ConceptoFacturable].[CategoriaConcepto_Id] = [dbo].[CategoriaConcepto].[Id] \r\n\r\n \r\nEND\r\n-- END OF [dbo].[cgp_ConceptoFacturable_Index]",
