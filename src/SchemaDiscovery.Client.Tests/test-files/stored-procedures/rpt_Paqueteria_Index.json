  "Definition": "-- =================================================================\r\n-- Description:\tThis gets a basic report for [Paqueteria] table\r\n-- =================================================================\r\nCREATE PROCEDURE [dbo].[rpt_Paqueteria_Index]\r\n@Comunidad_Id AS INT = 0,\r\n@EntityId AS INT = 0, \r\n@TipoPaquete_Id AS INT = 0, \r\n@Carrier_Id AS INT = 0, \r\n@EstatusPaqueteria_Id AS INT = 0\r\nAS\r\nBEGIN\r\n\t\r\n\t-- IMPORTANT:\r\n\t-- This is a computer generated procedure.  DO NOT ADD CUSTOM CODE TO THIS PROCEDURE.\r\n\r\n\t-- SET NOCOUNT ON added to prevent extra result sets from\r\n\t-- interfering with SELECT statements.\r\n\tSET NOCOUNT ON;\r\n\t\r\n\t-- 1) CREATE FILTER TABLE:\r\n\tDECLARE @PaqueteriaFilter TABLE (\r\n\t\tId INT IDENTITY (1,1),\r\n\t\tPaqueteria_Id INT\t\t\r\n\t)\r\n\r\n\r\n    -- IF A GIVEN ID HAS BEEN SPECIFIED, THEN RETRIEVE THAT RECORD ONLY\r\n\tIF @EntityId \u003C\u003E 0\r\n\tBEGIN\r\n\r\n\t\tINSERT INTO @PaqueteriaFilter (Paqueteria_Id)\r\n\t\tSELECT \r\n\t\t\t[Paqueteria].Id\r\n\t\tFROM [dbo].[Paqueteria]\r\n\t\tWHERE\r\n\t\t\t [dbo].[Paqueteria].[Id] = @EntityId\r\n\r\n\tEND\r\n\tELSE\r\n\tBEGIN\r\n\r\n\t\t-- 2) FILTER BY FOREIGN RELATIONSHIPS WHEN APLICABLE:\r\n\t\tINSERT INTO @PaqueteriaFilter (Paqueteria_Id)\r\n\t\tSELECT \r\n\t\t\t[Paqueteria].Id\r\n\t\tFROM [dbo].[Paqueteria] \r\n\t\tLEFT JOIN [Membresia] ON [Paqueteria].[Membresia_Id] = [Membresia].[Id] \r\n\t\tWHERE\r\n\t\t\t [Paqueteria].[Activo] = 1 AND\r\n         (([Paqueteria].[EstatusPaqueteria_Id] = @EstatusPaqueteria_Id) OR (@EstatusPaqueteria_Id = 0)) AND\r\n         (([Paqueteria].[TipoPaquete_Id] = @TipoPaquete_Id) OR (@TipoPaquete_Id = 0)) AND\r\n         (([Paqueteria].[Carrier_Id] = @Carrier_Id) OR (@Carrier_Id = 0)) AND\r\n         (([Membresia].[Comunidad_Id] = @Comunidad_Id) OR (@Comunidad_Id = 0))\r\n\r\n \tEND\r\n\r\n \r\n\t-- 4) DELIVER THE FILTERED RESULTS:\r\n\tSELECT \r\n\t\t[Paqueteria].[Id],\r\n\t\t[Paqueteria].[Membresia_Id],\r\n\t\t[Paqueteria].[TipoPaquete_Id],\r\n\t\t[Paqueteria].[Guia],\r\n\t\t[Paqueteria].[Carrier_Id],\r\n\t\t[Paqueteria].[Suscriptor_Id],\r\n\t\t[Paqueteria].[Fecha],\r\n\t\t[EntregaPaqueteria].[FechaEntrega],\r\n\t\t[Usuario].[Nombre] \u002B \u0027 \u0027 \u002B [Usuario].ApellidoPaterno \u002B \u0027 \u0027\u002B [Usuario].ApellidoMaterno AS EntregadoPor,\r\n\t\t[Paqueteria].[Activo],\r\n\t\t[Paqueteria].[FechaDesactivacion],\r\n\t\t[Paqueteria].[DesactivadoPor],\r\n\t\t[Membresia].[ClaveMembresia] \u002B \u0027 - \u0027 \u002B [dbo].[InformacionFacturacion].[NombreFiscal]  AS [MembresiaClaveMembresia],\r\n\t\t[Comunidad].[Nombre] AS Sucursal,\r\n\t\t[TipoPaquete].[Nombre] AS [TipoPaqueteNombre],\r\n\t\t[EstatusPaqueteria].[Nombre] AS [EstatusPaqueteria],\r\n\t\t[TipoPaquete].[Descripcion] AS [TipoPaqueteDescripcion],\r\n\t\t[Carrier].[Nombre] AS [CarrierNombre],\r\n\t\t[Carrier].[Descripcion] AS [CarrierDescripcion],\r\n\t\t[Suscriptor].[Nombre] \u002B \u0027 \u0027 \u002B [Suscriptor].[ApellidoPaterno] \u002B \u0027 \u0027 \u002B [Suscriptor].[ApellidoMaterno] \u002B \u0027 (\u0027 \u002B [Suscriptor].[CorreoElectronico] \u002B \u0027)\u0027 AS [SuscriptorCorreoElectronico],\r\n\t\t[Suscriptor].[Nombre] AS [SuscriptorNombre],\r\n\t\t[Paqueteria].[FechaCreacion],\r\n\t\t[Paqueteria].[CreadoPor],\r\n\t\t[Paqueteria].[FechaModificacion],\r\n\t\t[Paqueteria].[ModificadoPor]\r\n\tFROM @PaqueteriaFilter filter\r\n\t\tJOIN [dbo].[Paqueteria] \r\n\t\t\tON [Paqueteria].[Id] = filter.[Paqueteria_Id] \r\n\t\t\t\r\n\t\tLEFT JOIN [dbo].[Membresia]\r\n\t\tON [dbo].[Paqueteria].[Membresia_Id] = [dbo].[Membresia].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[TipoPaquete]\r\n\t\tON [dbo].[Paqueteria].[TipoPaquete_Id] = [dbo].[TipoPaquete].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[Carrier]\r\n\t\tON [dbo].[Paqueteria].[Carrier_Id] = [dbo].[Carrier].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[Suscriptor]\r\n\t\tON [dbo].[Paqueteria].[Suscriptor_Id] = [dbo].[Suscriptor].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[InformacionFacturacion]\r\n\t\tON [dbo].[Membresia].[InformacionFacturacion_Id] = [dbo].[InformacionFacturacion].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[Comunidad]\r\n\t\tON [dbo].[Membresia].[Comunidad_Id] = [dbo].[Comunidad].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[EstatusPaqueteria]\r\n\t\tON [dbo].[Paqueteria].[EstatusPaqueteria_Id] = [dbo].[EstatusPaqueteria].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[EntregaPaqueteria]\r\n\t\tON [dbo].[Paqueteria].[Id] = [dbo].[EntregaPaqueteria].[Paqueteria_Id] \r\n\r\n\t\tLEFT JOIN [dbo].[Usuario]\r\n\t\tON [dbo].[EntregaPaqueteria].[Usuario_Id] = [Usuario].[Id] \r\n\r\n\t\tORDER BY [Paqueteria].[FechaCreacion] \r\nEND\r\n-- END OF [dbo].[cgp_Paqueteria_Index]",
