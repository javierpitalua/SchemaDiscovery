  "Definition": "CREATE PROCEDURE [dbo].[rpt_ReglamentoLista_ObtenerListaReglamento]\n@ComunidadID INT\nAS\nBEGIN\n\nSELECT\n\tReglamento.Id,\n\tISNULL(Reglamento.Comunidad_Id, 0) AS [ComunidadID],\n\tISNULL(Comunidad.Nombre, \u0027Todas las Comunidades\u0027) AS [NombreComunidad],\n\tReglamento.Nombre AS [NombreReglamento],\n\tArchivo.NombreArchivo,\n\tArchivo.Url AS [ArchivoUrl],\n\tArchivo.ClaveServicioPersistencia,\n\tReglamento.FechaCreacion,\n\tReglamento.CreadoPor\nFROM Reglamento\n\tLEFT JOIN Comunidad\n\t\tON Reglamento.Comunidad_Id = Comunidad.Id\n\tLEFT JOIN Archivo\n\t\tON Reglamento.Archivo_Id = Archivo.Id\nWHERE Reglamento.Activo = 1\n\tAND ( Reglamento.Comunidad_Id IS NULL OR Reglamento.Comunidad_Id = 0 OR Reglamento.Comunidad_Id = @ComunidadID );\n\nEND",
  "Schema": "dbo",
