  "Definition": "CREATE PROCEDURE [dbo].[rpt_Aviso_Index]\n@EntityId AS INT = 0, \n@Comunidad_Id AS INT = 0, \n@Membresia_Id AS INT = 0\nAS\nBEGIN\n\t\n\t-- IMPORTANT:\n\t-- This is a computer generated procedure.  DO NOT ADD CUSTOM CODE TO THIS PROCEDURE.\n\n\t-- SET NOCOUNT ON added to prevent extra result sets from\n\t-- interfering with SELECT statements.\n\tSET NOCOUNT ON;\n\t\n\t-- 1) CREATE FILTER TABLE:\n\tDECLARE @AvisoFilter TABLE (\n\t\tId INT IDENTITY (1,1),\n\t\tAviso_Id INT\t\t\n\t)\n\n\n    -- IF A GIVEN ID HAS BEEN SPECIFIED, THEN RETRIEVE THAT RECORD ONLY\n\tIF @EntityId \u003C\u003E 0\n\tBEGIN\n\n\t\tINSERT INTO @AvisoFilter (Aviso_Id)\n\t\tSELECT \n\t\t\t[Aviso].Id\n\t\tFROM [dbo].[Aviso]\n\t\tWHERE\n\t\t\t [dbo].[Aviso].[Id] = @EntityId\n\n\tEND\n\tELSE\n\tBEGIN\n\n\t\t-- 2) FILTER BY FOREIGN RELATIONSHIPS WHEN APLICABLE:\n\t\tINSERT INTO @AvisoFilter (Aviso_Id)\n\t\tSELECT \n\t\t\t[Aviso].Id\n\t\tFROM [dbo].[Aviso]\n\t\tWHERE\n\t\t\t [Aviso].[Activo] = 1 AND\n         (([Aviso].[Comunidad_Id] = @Comunidad_Id) OR (@Comunidad_Id = 0)) AND\n         (([Aviso].[Membresia_Id] = @Membresia_Id) OR (@Membresia_Id = 0))\n\n \tEND\n\n \n\t-- 4) DELIVER THE FILTERED RESULTS:\n\tSELECT \n\t\t[Aviso].[Id],\n\t\t[Aviso].[Comunidad_Id],\n\t\t[Aviso].[Membresia_Id],\n\t\t[Aviso].[Titulo],\n\t\t[CategoriaDeAviso].[Nombre] AS [Categoria],\n\t\t[Aviso].[Liga],\n\t\t[Aviso].[FechaInicio],\n\t\t[Aviso].[FechaFin],\n\t\t[Aviso].[Activo],\n\t\t[Aviso].[FechaDesactivacion],\n\t\t[Aviso].[DesactivadoPor],\n\t\t[Comunidad].[Nombre] AS [ComunidadNombre],\n\t\t[Comunidad].[Descripcion] AS [ComunidadDescripcion],\n\t\t[Membresia].[ClaveMembresia] AS [MembresiaClaveMembresia],\n\t\t[Aviso].[FechaCreacion],\n\t\t[Aviso].[CreadoPor],\n\t\t[Aviso].[FechaModificacion],\n\t\t[Aviso].[ModificadoPor]\n\tFROM @AvisoFilter filter\n\t\tJOIN [dbo].[Aviso] \n\t\t\tON [Aviso].[Id] = filter.[Aviso_Id] \n\t\t\t\n\n\t\tLEFT JOIN [dbo].[Comunidad]\n\t\tON [dbo].[Aviso].[Comunidad_Id] = [dbo]