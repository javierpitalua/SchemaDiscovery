  "Definition": "CREATE PROCEDURE [dbo].[rpt_CicloFacturacionReporteItem_ObtenerReporte]\r\n@CicloFacturacion_Id INT, @Comunidad_Id INT = 0\r\nAS\r\nBEGIN\r\n\r\n\tSELECT  \r\n\t\tdetd.Id,\r\n\t\tdbo.fnObtenerDescripcionMes(ciclo.Mes) as Mes, \r\n\t\tciclo.Anio,  \r\n\t\tdoc.Folio as FolioFactura, \r\n\t\tcatd.Nombre as [Categoria],\r\n\t\tCASE ISNULL(doc.Pagado, 0) WHEN 1 THEN \u0027S\u00ED\u0027 ELSE \u0027No\u0027 END AS [Pagado],\r\n\t\tISNULL(doc.Pagado, 0) AS [MontoCubierto],\r\n\t\tmem.ClaveMembresia, \r\n\t\tinfo.RFC, \r\n\t\tinfo.RazonSocial, \r\n\t\tinfo.NombreFiscal, \r\n\t\tdetd.Descripcion as Concepto, \r\n\t\tdetd.Unidad, \r\n\t\tdetd.Unidades as Cantidad, \r\n\t\tdetd.PrecioUnitario, \r\n\t\tdetd.Total, \r\n\t\ttdc.Nombre AS Moneda,\r\n\t\tcom.Nombre AS Comunidad,\r\n\t\tdoc.MontoTotal AS [MontoFactura],\r\n\t\tdoc.IVA AS [IVA],\r\n\t\test.Nombre AS [EstatusDocumento]\r\n\tFROM DetalleDocumento detd\r\n\t\tjoin Documento doc on detd.Documento_Id = doc.Id\r\n\t\tjoin Membresia mem on doc.Membresia_Id = mem.Id\r\n\t\tleft join Comunidad com on mem.Comunidad_Id = com.Id\r\n\t\tjoin InformacionFacturacion info on doc.InformacionFacturacion_Id = info.Id\r\n\t\tjoin TipoDeCambio tdc on doc.TipoDeCambio_Id = tdc.Id\r\n\t\tjoin CategoriaDocumento catd ON doc.CategoriaDocumento_Id = catd.Id\r\n\t\tleft join CicloDeFacturacion ciclo on doc.CicloDeFacturacion_Id = ciclo.Id\r\n\t\tleft join EstatusDocumento est ON doc.EstatusDocumento_Id = est.Id\r\n\tWHERE \r\n\t\tdoc.Activo = 1 \r\n\tAND doc.CategoriaDocumento_Id IN (3, 8) -- Solo facturas y recibos\r\n\tAND (doc.CicloDeFacturacion_Id = @CicloFacturacion_Id OR @CicloFacturacion_Id IS NULL)\r\n\tAND NOT ((doc.EstatusDocumento_Id = 8) OR (doc.EstatusDocumento_Id = 9))-- eliminar las cancelaciones fiscales o documentos cancelados\r\n\tAND ((mem.Comunidad_Id = @Comunidad_Id) OR (@Comunidad_Id = 0))\r\n\tORDER BY\r\n\t\tdoc.Folio, mem.ClaveMembresia\r\n\r\nEND",
  "Schema": "dbo",
  "Name": "rpt_CicloFacturacionReporteItem_ObtenerReporte",
