  "Definition": "CREATE PROCEDURE [dbo].[rpt_SuscriptoresActivos_ObtenerSuscriptoresActivosPorMembresia]\r\n@MembresiaId INT\r\nAS\r\nBEGIN\r\n\r\nSELECT\r\n\t[Suscripcion].[Id],\r\n\t[Membresia].[Id] AS [MembresiaID],\r\n\t[Membresia].[ClaveMembresia],\r\n\t[Suscripcion].[TipoSuscripcion_Id],\r\n\t[TipoSuscripcion].[Nombre] AS [TipoSuscripcion],\r\n\tCASE ISNULL([Suscripcion].[DeshabilitarReservaciones], 0) WHEN 0 THEN \u0027No\u0027 WHEN 1 THEN \u0027Si\u0027 END AS [DeshabilitarReservaciones],\r\n\t[Suscripcion].[Activo],\r\n\t[Suscripcion].[Suscriptor_Id],\r\n\t([Suscriptor].[Nombre] \u002B \u0027 \u0027 \u002B [Suscriptor].[ApellidoPaterno] \u002B \u0027 \u0027 \u002B [Suscriptor].[ApellidoMaterno]) AS [NombreSuscriptor],\r\n\t[Suscriptor].[CorreoElectronico],\r\n\t[Suscriptor].[Telefono],\r\n\t[Suscriptor].[FechaCreacion] AS [FechaCreacionSuscriptor],\r\n\t[Suscriptor].[UltimaAutenticacion]\r\nFROM [Membresia]\r\n\tJOIN [Suscripcion]\r\n\t\tON [Membresia].[Id] = [Suscripcion].[Membresia_Id]\r\n\tJOIN [TipoSuscripcion]\r\n\t\tON [Suscripcion].[TipoSuscripcion_Id] = [TipoSuscripcion].[Id]\r\n\tJOIN [Suscriptor]\r\n\t\tON [Suscripcion].[Suscriptor_Id] = [Suscriptor].[Id]\r\nWHERE [Membresia].[Id] = @MembresiaId\r\nAND [Suscripcion].[Activo] = 1\r\nAND [Suscriptor].[Activo] = 1\r\n\r\nEND",
  "Schema": "dbo",
  "Name": "rpt_SuscriptoresActivos_ObtenerSuscriptoresActivosPorMembresia",
