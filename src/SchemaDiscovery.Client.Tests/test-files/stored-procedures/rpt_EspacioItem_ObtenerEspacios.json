  "Definition": "CREATE PROCEDURE rpt_EspacioItem_ObtenerEspacios\r\n@SearchTerm VARCHAR(100) = \u0027\u0027\r\nAS\r\nBEGIN\r\n\r\n\tSELECT TOP 30 esp.Id, esp.Nombre, ubi.Nombre AS [Ubicacion], tipo.Nombre AS [TipoDeEspacio]\r\n\tFROM Espacio esp\r\n\tJOIN Ubicacion ubi ON esp.Ubicacion_Id = ubi.Id\r\n\tJOIN TipoDeEspacio tipo ON esp.TipoDeEspacio_Id = tipo.Id\r\n\tWHERE NOT (esp.TipoDeEspacio_Id = 4)\r\n\tAND (esp.Nombre LIKE @SearchTerm OR @SearchTerm = \u0027\u0027)\r\n\tORDER BY ubi.Nombre, esp.Nombre\r\n\r\nEND",
