  "Definition": "CREATE PROCEDURE [dbo].[rpt_MembresiasExcel_ObtenerExcelMembresiasPorVencer]\r\nAS\r\nBEGIN\r\n\r\nSELECT \r\n\tmem.Id,\r\n\tmem.ClaveMembresia,\r\n\tinfo.NombreFiscal AS [NombreCliente],\r\n\ttpm.Nombre AS [TipoMembresia],\r\n\tCONVERT (VARCHAR(10), mem.FechaInicio, 103) AS [FechaInicio],\r\n\tCONVERT (VARCHAR(10), mem.Vigencia, 103) AS [FechaVigencia],\r\n\tmem.PrecioMensual AS [RentaMensual],\r\n\t(mem.PrecioMensual * 0.05) \u002B mem.PrecioMensual AS [RentaSugerida],\r\n\tst.Nombre AS [Estatus],\r\n\tCASE\r\n        WHEN mem.Vigencia \u003E= GETDATE()\r\n        THEN CAST(DATEDIFF(day, GETDATE(), mem.Vigencia) AS varchar)\r\n        ELSE \u0027\u0027\r\n    END AS [DiasPorVencer],\r\n    CASE\r\n        WHEN mem.Vigencia \u003C GETDATE()\r\n        THEN CAST(DATEDIFF(day, mem.Vigencia, GETDATE()) AS varchar)\r\n        ELSE \u0027\u0027\r\n    END AS [DiasVencidos],\r\n\tmem.Vendedor_Id,\r\n\tISNULL(usr.Nombre, \u0027\u0027) \u002B \u0027 \u0027 \u002B ISNULL(usr.ApellidoPaterno, \u0027\u0027) \u002B \u0027 \u0027 \u002B ISNULL(usr.ApellidoMaterno, \u0027\u0027) AS [Vendedor],\r\n\tusr.CorreoElectronico AS [CorreoVendedor],\r\n\tmem.Espacio_Id,\r\n\tesp.Nombre AS [Espacio],\r\n\tmem.Comunidad_Id,\r\n\tcom.Nombre AS [Comunidad],\r\n\tmem.Vigencia\r\nFROM Membresia mem \r\n\tJOIN InformacionFacturacion info \r\n\t\tON mem.InformacionFacturacion_Id = info.Id\r\n\tLEFT JOIN EstatusMembresia st \r\n\t\tON mem.EstatusMembresia_Id = st.Id\r\n\tLEFT JOIN Usuario usr\r\n\t\tON mem.Vendedor_Id = usr.Id\r\n\tLEFT JOIN TipoMembresia tpm\r\n\t\tON mem.TipoMembresia_Id = tpm.Id\r\n\tLEFT JOIN Comunidad com\r\n\t\tON mem.Comunidad_Id = com.Id\r\n\tLEFT JOIN Espacio esp\r\n\t\tON mem.Espacio_Id = esp.Id\r\nWHERE mem.EstatusMembresia_Id IN (1, 3) AND mem.Activo = 1\r\n\tAND mem.TipoMembresia_Id NOT IN (1, 24)\r\n\tAND ( mem.Vigencia BETWEEN GETDATE() AND DATEADD(DAY, 30, GETDATE()) OR mem.Vigencia BETWEEN DATEADD(MONTH, -3, GETDATE()) AND GETDATE() )\r\nORDER BY mem.Comunidad_Id, mem.Vendedor_Id, DiasVencidos DESC, DiasPorVencer ASC\r\n\r\nEND",
  "Schema": "dbo",
  "Name": "rpt_MembresiasExcel_ObtenerExcelMembresiasPorVencer",
  "ObjectType": "StoredProcedure",
  "QualifiedName": "dbo.rpt_MembresiasExcel_ObtenerExcelMembresiasPorVencer"
