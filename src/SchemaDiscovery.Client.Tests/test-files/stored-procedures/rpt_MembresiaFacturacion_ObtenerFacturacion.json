  "Definition": "-- =================================================================\r\n-- Description:\tThis gets a basic report for [Membresia] table\r\n-- =================================================================\r\nCREATE PROCEDURE [dbo].[rpt_MembresiaFacturacion_ObtenerFacturacion]\r\n@CicloDeFacturacion_Id AS INT \r\nAS\r\nBEGIN\r\n\r\n\t--SET NOCOUNT ON;\r\n\t\r\n\t-- 1) CREATE FILTER TABLE:\r\n\tDECLARE @MembresiaFilter TABLE (\r\n\t\tId INT IDENTITY (1,1),\r\n\t\tMembresia_Id INT\t\t\r\n\t)\r\n\r\n\tDECLARE @DocumentosFilter TABLE(\r\n\t\tId INT IDENTITY (1,1),\r\n\t\tDocumento_Id INT,\r\n\t\tMembresia_Id INT\r\n\t)\r\n\r\n\tINSERT INTO @MembresiaFilter (Membresia_Id)\r\n\tSELECT mem.Id FROM [dbo].[Membresia] mem\r\n\t\tWHERE \r\n\t\t\tmem.Activo = 1\t\t\r\n\r\n\tINSERT INTO @DocumentosFilter (Documento_Id, Membresia_Id)\r\n\tSELECT doc.Id, doc.Membresia_Id FROM [dbo].[Documento] doc\r\n\tJOIN @MembresiaFilter mem ON doc.Membresia_Id = mem.Membresia_Id\r\n\tWHERE \r\n\t\tdoc.CicloDeFacturacion_Id = @CicloDeFacturacion_Id \r\n\tAND doc.CategoriaDocumento_Id IN (3, 8)\r\n\t\r\n\r\n\t-- 4) DELIVER THE FILTERED RESULTS:\r\n\tSELECT \r\n\t\t[Membresia].[Id],\r\n\t\t[Membresia].[Comunidad_Id],\r\n\t\t[Membresia].[ClaveMembresia],\r\n\t\t[InformacionFacturacion].[NombreFiscal],\r\n\t\t[InformacionFacturacion].[RazonSocial],\r\n\t\t[InformacionFacturacion].[RFC],\r\n\t\t[TipoMembresia].[Nombre] AS [TipoMembresiaNombre],\r\n\t\t[EstatusMembresia].[Nombre] AS [EstatusMembresiaNombre],\t\t\r\n\t\t[Membresia].[FacturarAPartirDe],\r\n\t\t[Membresia].[FechaInicio] AS [FechaInicio],\r\n\t\t[Membresia].[Vigencia],\t\t\t\t\t\t\r\n\t\t[Membresia].[FechaCreacion] as [FechaCreacion],\r\n\t\t[Membresia].[CreadoPor] as [CreadoPor],\r\n\t\tCASE ISNULL([Membresia].[DeshabilitarFacturacionAutomatica], 0) WHEN 0 THEN \u0027No\u0027 ELSE \u0027S\u00ED\u0027 END AS [DeshabilitarFacturacion],\r\n\t\tCASE ISNULL(doc.Id, 0) WHEN 0 THEN \u0027No\u0027 ELSE \u0027S\u00ED\u0027 END AS [Facturacion],\r\n\t\t[Membresia].[PrecioMensual],\r\n\t\tdoc.Folio,\r\n\t\tcat.Nombre AS [TipoDocumento],\r\n\t\tdoc.MontoTotal AS [MontoFacturado],\r\n\t\tdoc.IVA AS [IVA],\r\n\t\tdoc.MontoTotal \u002B doc.IVA AS [MontoFacturadoMasIVA],\r\n\t\ttdc.Nombre AS [TipoDeCambio]\t\t\r\n\tFROM @MembresiaFilter filter\r\n\t\tJOIN [dbo].[Membresia] \r\n\t\t\tON [Membresia].[Id] = filter.[Membresia_Id] \t\t\t\r\n\r\n\t\tLEFT JOIN [dbo].[Comunidad]\r\n\t\tON [dbo].[Membresia].[Comunidad_Id] = [dbo].[Comunidad].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[TipoMembresia]\r\n\t\tON [dbo].[Membresia].[TipoMembresia_Id] = [dbo].[TipoMembresia].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[EstatusMembresia]\r\n\t\tON [dbo].[Membresia].[EstatusMembresia_Id] = [dbo].[EstatusMembresia].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[InformacionFacturacion]\r\n\t\tON [dbo].[Membresia].[InformacionFacturacion_Id] = [dbo].[InformacionFacturacion].[Id] \r\n\r\n\t\tLEFT JOIN @DocumentosFilter docTmp\r\n\t\tON\t[dbo].[Membresia].Id = docTmp.Membresia_Id\r\n\r\n\t\tLEFT JOIN Documento doc\r\n\t\tON doc.Id = docTmp.Documento_Id\r\n\r\n\t\tLEFT JOIN TipoDeCambio tdc\r\n\t\tON doc.TipoDeCambio_Id = tdc.Id\r\n\r\n\t\tLEFT JOIN CategoriaDocumento cat\r\n\t\tON doc.CategoriaDocumento_Id = cat.Id\r\n\r\n\t\tWHERE [Membresia].[Activo]= 1\r\n\tORDER BY [Membresia].[Id] DESC\r\n \r\nEND",
  "Schema": "dbo",
  "Name": "rpt_MembresiaFacturacion_ObtenerFacturacion",
  "ObjectType": "StoredProcedure",
  "QualifiedName": "dbo.rpt_MembresiaFacturacion_ObtenerFacturacion"
}