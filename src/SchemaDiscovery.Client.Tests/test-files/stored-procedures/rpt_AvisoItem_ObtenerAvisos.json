  "Definition": "CREATE PROCEDURE [dbo].[rpt_AvisoItem_ObtenerAvisos]\r\n@Suscriptor_Id INT = 0\r\nAS\r\nBEGIN\r\n\r\n\tDECLARE @FechaActual SMALLDATETIME\r\n\r\n\tSET @FechaActual = GETDATE()\r\n\r\n\tDECLARE @Avisos TABLE (\r\n\t\tId INT IDENTITY(1, 1),\r\n\t\tAviso_Id INT\r\n\t)\r\n\t\t\r\n\tINSERT INTO @Avisos(Aviso_Id)\r\n\tSELECT \r\n\t\tav.Id\r\n\tFROM Aviso av\r\n\tWHERE \r\n\t\tav.Activo = 1\r\n\tAND (ISNULL(av.Comunidad_Id, 0) = 0 OR ISNULL(av.Membresia_Id, 0) = 0)\r\n\tAND (av.FechaInicio \u003C= @FechaActual) AND (@FechaActual \u003C= av.FechaFin OR av.FechaFin IS NULL) \r\n\t\t\r\n\t-- Agregar avisos dirigidos por comunidad\r\n\tINSERT INTO @Avisos(Aviso_Id)\r\n\tSELECT \r\n\t\tav.Id\r\n\tFROM Aviso av\r\n\tJOIN Suscripcion sus \r\n\t\tON av.Membresia_Id = sus.Membresia_Id\r\n\tWHERE\r\n\t\tsus.Suscriptor_Id = @Suscriptor_Id\r\n\tAND\tav.Activo = 1\r\n\tAND (av.FechaInicio \u003C= @FechaActual) AND (@FechaActual \u003C= av.FechaFin OR av.FechaFin IS NULL) \r\n\r\n\t-- Agregar avisos dirigidos por comunidad\r\n\tINSERT INTO @Avisos(Aviso_Id)\r\n\tSELECT \r\n\t\tav.Id\r\n\tFROM Aviso av\r\n\tJOIN Suscripcion sus \r\n\t\tON av.Membresia_Id = sus.Membresia_Id\r\n    JOIN Membresia mem\r\n\t\tON sus.Membresia_Id = mem.Id\r\n\t\tAND av.Comunidad_Id = mem.Comunidad_Id\r\n\tWHERE\r\n\t\tsus.Suscriptor_Id = @Suscriptor_Id    \t\r\n\tAND\tav.Activo = 1\r\n\tAND (av.FechaInicio \u003C= @FechaActual) AND (@FechaActual \u003C= av.FechaFin OR av.FechaFin IS NULL);\r\n\r\n\tWITH resultCTE AS (\r\n\t\tSELECT Aviso_Id FROM @Avisos GROUP BY Aviso_Id\r\n\t)\r\n\r\n\tSELECT \r\n\t\tav.Id,\r\n\t\tav.Titulo, \r\n\t\tav.Mensaje,\r\n\t\tav.Liga,\r\n\t\tav.Membresia_Id,\r\n\t\tmem.ClaveMembresia,\r\n\t\tav.Comunidad_Id,\r\n\t\tcom.Nombre AS [Comunidad],\r\n\t\tav.CategoriaDeAviso_Id,\r\n\t\tcat.Nombre AS [Categoria],\r\n\t\tav.FechaInicio,\r\n\t\tav.FechaFin,\r\n\t\tav.FechaCreacion,\r\n\t\tav.CreadoPor,\r\n\t\tav.FechaModificacion,\r\n\t\tav.ModificadoPor\r\n\tFROM Aviso av\r\n\tJOIN resultCTE rs ON rs.Aviso_Id = av.Id\r\n\tLEFT JOIN CategoriaDeAviso cat\r\n\t\tON av.CategoriaDeAviso_Id = cat.Id\r\n\tLEFT JOIN Comunidad com \r\n\t\tON av.Comunidad_Id = com.Id\r\n\tLEFT JOIN Membresia mem\r\n\t\tON av.Membresia_Id = mem.Id\r\n\t\r\nEND\r\n",
  "Schema": "dbo",
  "Name": "rpt_AvisoItem_ObtenerAvisos",
  "ObjectType": "StoredProcedure",
  "QualifiedName": "dbo.rpt_AvisoItem_ObtenerAvisos"
