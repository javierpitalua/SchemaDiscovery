  "Definition": "CREATE PROCEDURE [dbo].[rpt_Reservaciones_ObtenerDisponibilidad]\r\n@Comunidad_Id INT = 0\r\nAS\r\nBEGIN\r\n\r\n\t--DECLARE @FechaHoraInicial SMALLDATETIME\r\n\t--DECLARE @FechaHoraFinal SMALLDATETIME\r\n\r\n\t--TODO: Completar la informacion de las salas de juntas\r\n\r\n\tSELECT esp.Id, esp.Nombre \r\n\tFROM Espacio esp \r\n\tWHERE \r\n\t\tesp.TipoDeEspacio_Id = 4\r\n\tAND esp.Comunidad_Id = @Comunidad_Id\r\n\r\nEND",
