  "Definition": "-- =================================================================\r\n-- Description:\tThis gets a basic report for [RegistroPago] table\r\n-- =================================================================\r\nCREATE PROCEDURE [dbo].[rpt_RegistroPago_Index]\r\n@EntityId AS INT = 0, \r\n@Documento_Id AS INT = 0, \r\n@CuentaReceptora_Id AS INT = 0\r\nAS\r\nBEGIN\r\n\t\r\n\t-- IMPORTANT:\r\n\t-- This is a computer generated procedure.  DO NOT ADD CUSTOM CODE TO THIS PROCEDURE.\r\n\r\n\t-- SET NOCOUNT ON added to prevent extra result sets from\r\n\t-- interfering with SELECT statements.\r\n\tSET NOCOUNT ON;\r\n\t\r\n\t-- 1) CREATE FILTER TABLE:\r\n\tDECLARE @RegistroPagoFilter TABLE (\r\n\t\tId INT IDENTITY (1,1),\r\n\t\tRegistroPago_Id INT\t\t\r\n\t)\r\n\r\n\r\n    -- IF A GIVEN ID HAS BEEN SPECIFIED, THEN RETRIEVE THAT RECORD ONLY\r\n\tIF @EntityId \u003C\u003E 0\r\n\tBEGIN\r\n\r\n\t\tINSERT INTO @RegistroPagoFilter (RegistroPago_Id)\r\n\t\tSELECT \r\n\t\t\t[RegistroPago].Id\r\n\t\tFROM [dbo].[RegistroPago]\r\n\t\tWHERE\r\n\t\t\t [dbo].[RegistroPago].[Id] = @EntityId\r\n\r\n\tEND\r\n\tELSE\r\n\tBEGIN\r\n\r\n\t\t-- 2) FILTER BY FOREIGN RELATIONSHIPS WHEN APLICABLE:\r\n\t\tINSERT INTO @RegistroPagoFilter (RegistroPago_Id)\r\n\t\tSELECT \r\n\t\t\t[RegistroPago].Id\r\n\t\tFROM [dbo].[RegistroPago]\r\n\t\tWHERE\r\n\t\t\t (([RegistroPago].[Documento_Id] = @Documento_Id) OR (@Documento_Id = 0)) AND\r\n         (([RegistroPago].[CuentaReceptora_Id] = @CuentaReceptora_Id) OR (@CuentaReceptora_Id = 0))\r\n\r\n \tEND\r\n\r\n \r\n\t-- 4) DELIVER THE FILTERED RESULTS:\r\n\tSELECT \r\n\t\t[RegistroPago].[Id],\r\n\t\t[RegistroPago].[Folio],\r\n\t\t[RegistroPago].[Serie],\r\n\t\t[RegistroPago].[Documento_Id],\r\n\t\t[Documento].[Folio],\r\n\t\t[Membresia].[ClaveMembresia],\r\n\t\t[CuentaReceptora].[Nombre] AS [Cuenta],\r\n\t\t[RegistroPago].[ImportePagado],\r\n\t\t[RegistroPago].[SaldoAnterior],\r\n\t\t[RegistroPago].[SaldoInsoluto],\r\n\t\t[RegistroPago].[CuentaReceptora_Id],\r\n\t\t[RegistroPago].[Timbrado],\r\n\t\t[RegistroPago].[Fecha],\r\n\t\t[RegistroPago].[SolicitudTimbrado],\r\n\t\t[RegistroPago].[RespuestaTimbrado]\t\t\r\n\t\t\r\n\tFROM @RegistroPagoFilter filter\r\n\t\tJOIN [dbo].[RegistroPago] \r\n\t\t\tON [RegistroPago].[Id] = filter.[RegistroPago_Id] \t\t\t\r\n\r\n\t\tLEFT JOIN [dbo].[Documento]\r\n\t\tON [dbo].[RegistroPago].[Documento_Id] = [dbo].[Documento].[Id] \r\n\r\n\t\tLEFT JOIN [dbo].[Membresia]\r\n\t\tON [dbo].[Documento].[Membresia_Id] = [dbo].[Membresia].[Id] \r\n\r\n \t\tLEFT JOIN [dbo].[CuentaReceptora]\r\n\t\tON [dbo].[RegistroPago].[CuentaReceptora_Id] = [dbo].[CuentaReceptora].[Id] \r\n\r\n \r\nEND\r\n-- END OF [dbo].[cgp_RegistroPago_Index]",
