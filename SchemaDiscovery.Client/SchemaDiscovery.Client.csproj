<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{D635177F-073C-456A-A5E4-7567528AC658}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>SchemaDiscovery.Client</RootNamespace>
    <AssemblyName>SchemaDiscovery.Client</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- NuGet package metadata. Bump <Version> before each release; the CI
       release workflow (.github/workflows/publish-nuget.yml) overrides it
       from the pushed git tag, so this value is only what local pack runs
       produce.
       This is a non-SDK-style project (targets classic .NET Framework
       tooling directly), so `dotnet pack` won't work here — the Pack MSBuild
       target normally comes from the SDK. The NuGet.Build.Tasks.Pack package
       below adds that target so the project can be packed the same way via
       `msbuild /t:Pack` (or `dotnet msbuild /t:Pack`) using the exact same
       properties an SDK-style project would use. -->
  <PropertyGroup>
    <PackageId>SchemaDiscovery.Client</PackageId>
    <Version>1.0.0</Version>
    <Authors>Javier Pitalua</Authors>
    <Description>Reads the JSON files produced by the schema-discovery CLI back into typed .NET objects (tables, views, stored procedures, functions), for tools that consume a scanned database schema — code generators, ORM scaffolders, and the like.</Description>
    <PackageTags>database;schema;sql-server;postgres;mysql;json;codegen</PackageTags>
    <PackageProjectUrl>https://github.com/javierpitalua/SchemaDiscovery</PackageProjectUrl>
    <RepositoryUrl>https://github.com/javierpitalua/SchemaDiscovery</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Sparse XML doc comments are intentional (see repo conventions) —
         don't warn on public members that don't have one. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Build.Tasks.Pack" Version="6.9.1" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packed into the .nupkg so it shows up on nuget.org / internal feeds. -->
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="..\LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ProjectLoader.cs" />
    <Compile Include="Models\Project.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\SchemaDiscovery.Abstractions\SchemaDiscovery.Abstractions.csproj">
      <Project>{a1000000-0000-0000-0000-000000000001}</Project>
      <Name>SchemaDiscovery.Abstractions</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>